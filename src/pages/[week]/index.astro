---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoFrame from '../../components/DemoFrame.astro';
import { getWeeks, slugOf, pad, formatDate } from '../../lib/weeks';

export async function getStaticPaths() {
  const weeks = await getWeeks();
  return weeks.map((entry, i) => ({
    params: { week: slugOf(entry) },
    props: { entry, prev: weeks[i - 1] ?? null, next: weeks[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { week, title, date, tags, summary } = entry.data;
const slug = slugOf(entry);
---
<Base title={`Week ${pad(week)} · ${title}`} description={summary || title}>
  <header class="post-head">
    <div class="kicker">Week {pad(week)}</div>
    <h1>{title}</h1>
    <div class="meta">
      <span>{formatDate(date)}</span>
      {tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
      <a class="demo-link" href={`/${slug}/demo`} target="_blank" rel="noopener">Open live demo</a>
    </div>
  </header>

  <article class="prose">
    <Content components={{ Demo: DemoFrame }} />
  </article>

  <nav class="post-nav">
    <span>{prev && <a href={`/${slugOf(prev)}`}>← Week {pad(prev.data.week)}: {prev.data.title}</a>}</span>
    <span class="next">{next && <a href={`/${slugOf(next)}`}>Week {pad(next.data.week)}: {next.data.title} →</a>}</span>
  </nav>
</Base>
