---
import Base from '../layouts/Base.astro';
import WeekCard from '../components/WeekCard.astro';
import { getWeeks, tagCounts, TOTAL_WEEKS, pad } from '../lib/weeks';

const weeks = await getWeeks();
const byWeek = new Map(weeks.map((w) => [w.data.week, w]));
const tags = tagCounts(weeks);
const slots = Array.from({ length: TOTAL_WEEKS }, (_, i) => i + 1);
---
<Base>
  <section class="intro">
    <h1>14 weeks of interface experiments</h1>
    <p>Each week: a vibe-coded design experiment, the process behind it, and what critique said.</p>
  </section>

  {tags.length > 0 && (
    <ul class="chips" id="tag-filter" aria-label="Filter by topic">
      <li><button class="chip is-active" data-tag="">All</button></li>
      {tags.map(([tag, count]) => (
        <li><button class="chip" data-tag={tag}>{tag}<span class="count">{count}</span></button></li>
      ))}
    </ul>
  )}

  <ol class="timeline" id="timeline">
    {slots.map((n) => {
      const entry = byWeek.get(n);
      return entry
        ? <WeekCard entry={entry} />
        : <li class="slot is-upcoming" data-tags=""><span class="num">Week {pad(n)}</span><span>Upcoming</span></li>;
    })}
  </ol>
</Base>

<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#tag-filter .chip')];
  const slots = [...document.querySelectorAll<HTMLElement>('#timeline .slot')];

  function apply(tag: string) {
    for (const c of chips) c.classList.toggle('is-active', (c.dataset.tag ?? '') === tag);
    for (const s of slots) {
      const has = (s.dataset.tags ?? '').split(' ').includes(tag);
      s.classList.toggle('is-hidden', tag !== '' && !has);
    }
    history.replaceState(null, '', tag ? `#${encodeURIComponent(tag)}` : location.pathname);
  }

  for (const c of chips) c.addEventListener('click', () => apply(c.dataset.tag ?? ''));

  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial && chips.some((c) => c.dataset.tag === initial)) apply(initial);
</script>
