---
import Base from '../../layouts/Base.astro';
import WeekCard from '../../components/WeekCard.astro';
import { getWeeks, tagCounts } from '../../lib/weeks';

export async function getStaticPaths() {
  const weeks = await getWeeks();
  return tagCounts(weeks).map(([tag]) => ({
    params: { tag },
    props: { weeks: weeks.filter((w) => w.data.tags.includes(tag)) },
  }));
}
const { tag } = Astro.params;
const { weeks } = Astro.props;
---
<Base title={`#${tag}`}>
  <section class="intro">
    <h1>#{tag}</h1>
    <p>{weeks.length} {weeks.length === 1 ? 'week' : 'weeks'} · <a href="/tags">all topics</a></p>
  </section>
  <ol class="timeline">
    {weeks.map((entry) => <WeekCard entry={entry} />)}
  </ol>
</Base>
