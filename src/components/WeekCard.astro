---
import { slugOf, pad, formatDate, type Week } from '../lib/weeks';
interface Props { entry: Week }
const { entry } = Astro.props;
const { week, title, summary, tags, date, status } = entry.data;
---
<li class:list={['slot', { 'is-draft': status === 'draft' }]} data-tags={tags.join(' ')}>
  <a href={`/${slugOf(entry)}`}>
    <span class="num">Week {pad(week)}</span>
    <div>
      <p class="title">{title}</p>
      {summary && <p class="summary">{summary}</p>}
      <div class="meta">
        <span>{formatDate(date)}</span>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
  </a>
</li>
