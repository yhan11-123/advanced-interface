---
/**
 * Embeds the current week's live demo (/week-XX/demo) inside the post.
 * Used in index.mdx as <Demo /> (mapped in pages/[week]/index.astro).
 * Optional: <Demo height="60vh" />
 */
interface Props { height?: string }
const { height = '70vh' } = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean)[0];
const src = `/${slug}/demo`;
---
<figure class="demo-frame">
  <iframe src={src} title="Live demo" loading="lazy" style={`height:${height}`}></iframe>
  <figcaption>
    <span>Live demo. Interact with it here or open it on its own.</span>
    <a href={src} target="_blank" rel="noopener">Open full screen</a>
  </figcaption>
</figure>
