---
/**
 * This is the live experiment for the week. It renders at /week-XX/demo
 * and is embedded in the post wherever <Demo /> appears in index.mdx.
 *
 * Anything goes here: plain HTML/CSS/JS, or a React component with client:load.
 * <style> is scoped to this file, so demos never leak styles into each other.
 * Use <style is:global> if you need to style <body> (backgrounds, fonts).
 */
---
<style is:global>
  body { display: grid; place-items: center; font-family: system-ui, sans-serif; background: #111; color: #eee; }
</style>

<main class="stage">
  <h1>Week demo</h1>
  <p>Replace this file with your experiment.</p>
</main>

<style>
  .stage { text-align: center; }
  h1 { font-weight: 600; letter-spacing: -0.02em; }
</style>
