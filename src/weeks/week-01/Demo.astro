---
// Week 01: cursor-reactive gradient field. Plain HTML/CSS/JS, no framework.
---
<style is:global>
  body { background: #0e0e12; overflow: hidden; }
</style>

<div class="field" id="field">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
  <p class="hint">move the pointer</p>
</div>

<style>
  .field { position: fixed; inset: 0; }
  .blob {
    position: absolute; left: 0; top: 0;
    width: 46vmax; height: 46vmax; border-radius: 50%;
    filter: blur(60px); mix-blend-mode: screen; opacity: .9;
    transform: translate(-50%, -50%);
    will-change: transform;
  }
  .b1 { background: #ff7a59; }
  .b2 { background: #2b47ff; width: 56vmax; height: 56vmax; }
  .b3 { background: #29d3a3; width: 36vmax; height: 36vmax; }
  .hint {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    margin: 0; font: 500 14px/1 system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(255,255,255,.55); pointer-events: none; transition: opacity .6s;
  }
  .field.is-live .hint { opacity: 0; }
</style>

<script>
  const field = document.getElementById('field')!;
  const blobs = [...field.querySelectorAll<HTMLElement>('.blob')];

  // Each blob has its own idle orbit and its own easing toward the pointer.
  const state = blobs.map((el, i) => ({
    el, x: innerWidth / 2, y: innerHeight / 2,
    ease: [0.03, 0.015, 0.06][i], phase: i * 2.1, radius: 90 + i * 70, speed: 0.0004 + i * 0.00015,
  }));

  let target = { x: innerWidth / 2, y: innerHeight / 2 };
  let live = false;

  const onMove = (x: number, y: number) => {
    target = { x, y };
    if (!live) { live = true; field.classList.add('is-live'); }
  };
  addEventListener('pointermove', (e) => onMove(e.clientX, e.clientY));
  addEventListener('touchmove', (e) => onMove(e.touches[0].clientX, e.touches[0].clientY), { passive: true });

  function frame(t: number) {
    for (const b of state) {
      const idleX = Math.cos(t * b.speed + b.phase) * b.radius;
      const idleY = Math.sin(t * b.speed * 1.3 + b.phase) * b.radius;
      b.x += (target.x + idleX - b.x) * b.ease;
      b.y += (target.y + idleY - b.y) * b.ease;
      b.el.style.transform = `translate(${b.x}px, ${b.y}px) translate(-50%, -50%)`;
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>
