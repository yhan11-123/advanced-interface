---
/**
 * Week 01 research instrument: a survey of existing loading patterns.
 *
 * Every specimen runs off one shared clock, so the same real duration can be
 * compared across patterns. Two controls come straight from the research:
 *   - duration, set at Nielsen's 1 s / 3 s / 10 s thresholds
 *   - step granularity, to test Ziat et al. 2022 (more, smaller steps read faster)
 */
const DETERMINATE = [
  { id: 'bar', name: 'Linear bar', note: 'The default. Length maps to progress.' },
  { id: 'ring', name: 'Ring', note: 'Same data, no sense of remaining distance.' },
  { id: 'seg', name: 'Segmented', note: 'Progress as countable chunks.' },
  { id: 'num', name: 'Numeric', note: 'Precise, but nothing to watch.' },
];
const INDETERMINATE = [
  { id: 'spin', name: 'Spinner', note: 'Points at the wait itself.' },
  { id: 'ibar', name: 'Indeterminate bar', note: 'Grows and shrinks along a track.' },
  { id: 'dots', name: 'Dots', note: 'Reads as thinking, not working.' },
  { id: 'skel', name: 'Skeleton', note: 'Describes what is coming.' },
];
---

<style is:global>
  body { background: #f2f0ea; margin: 0; }
</style>

<main class="sheet">
  <header class="head">
    <h1>Loading pattern survey</h1>
    <p class="lede">
      Eight existing patterns on one shared clock. Same real duration in every cell,
      so the only difference is how the wait is described.
    </p>

    <div class="controls">
      <div class="ctrl" role="group" aria-label="Duration">
        <span class="ctrl-label">Duration</span>
        <button data-duration="1000">1 s</button>
        <button data-duration="3000" class="on">3 s</button>
        <button data-duration="10000">10 s</button>
      </div>
      <div class="ctrl" role="group" aria-label="Step granularity">
        <span class="ctrl-label">Steps</span>
        <button data-steps="0" class="on">smooth</button>
        <button data-steps="5">5</button>
        <button data-steps="20">20</button>
      </div>
      <button id="toggle" class="run" aria-pressed="false">Pause</button>
    </div>
    <p class="motion-note">Motion is parked because this device asks for reduced motion.</p>
  </header>

  <section class="group">
    <h2>Determinate <span>progress is known</span></h2>
    <div class="grid">
      {DETERMINATE.map((s) => (
        <figure class="spec" data-spec={s.id}>
          <div class="stage">
            {s.id === 'bar' && (
              <div class="bar" role="progressbar" aria-label="Linear bar" aria-valuemin="0" aria-valuemax="100"><i></i></div>
            )}
            {s.id === 'ring' && (
              <svg class="ring" viewBox="0 0 68 68" role="progressbar" aria-label="Ring" aria-valuemin="0" aria-valuemax="100">
                <circle class="ring-track" cx="34" cy="34" r="26" />
                <circle class="ring-fill" cx="34" cy="34" r="26" />
              </svg>
            )}
            {s.id === 'seg' && (
              <div class="seg" role="progressbar" aria-label="Segmented" aria-valuemin="0" aria-valuemax="100">
                {Array.from({ length: 20 }, () => <i></i>)}
              </div>
            )}
            {s.id === 'num' && (
              <div class="num" role="progressbar" aria-label="Numeric" aria-valuemin="0" aria-valuemax="100">0%</div>
            )}
          </div>
          <figcaption><b>{s.name}</b><span>{s.note}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="group">
    <h2>Indeterminate <span>progress is unknown</span></h2>
    <div class="grid">
      {INDETERMINATE.map((s) => (
        <figure class="spec" data-spec={s.id}>
          <div class="stage">
            {s.id === 'spin' && <div class="spinner" role="progressbar" aria-label="Spinner, working"></div>}
            {s.id === 'ibar' && <div class="ibar" role="progressbar" aria-label="Indeterminate bar, working"><i></i></div>}
            {s.id === 'dots' && (
              <div class="dots" role="progressbar" aria-label="Dots, working"><span></span><span></span><span></span></div>
            )}
            {s.id === 'skel' && (
              <div class="skel" role="progressbar" aria-label="Skeleton, working">
                <span class="w70"></span><span class="w100"></span><span class="w45"></span>
              </div>
            )}
          </div>
          <figcaption><b>{s.name}</b><span>{s.note}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <footer class="foot">
    Reference only. None of these are my designs; they are the baseline I am designing against.
  </footer>
</main>

<style>
  .sheet {
    --p: 0;
    --ink: #1a1a1a;
    --muted: #77756e;
    --line: #dcdad2;
    --surface: #fbfaf7;
    --accent: #2b47ff;
    --bone: #e4e1d8;
    box-sizing: border-box;
    width: min(1040px, 100% - 32px);
    margin: 0 auto;
    padding: 40px 0 56px;
    font-family: ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", sans-serif;
    color: var(--ink);
  }
  .sheet *, .sheet *::before, .sheet *::after { box-sizing: border-box; }

  .head h1 { font-size: 22px; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 6px; }
  .lede { margin: 0 0 20px; max-width: 58ch; color: var(--muted); font-size: 14px; line-height: 1.55; }

  .controls { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; }
  .ctrl { display: flex; align-items: center; gap: 6px; }
  .ctrl-label {
    font-size: 11px; text-transform: uppercase; letter-spacing: .09em;
    color: var(--muted); margin-right: 2px;
  }
  .controls button {
    font: 500 12.5px/1 inherit; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 999px; padding: 6px 12px; cursor: pointer;
    transition: background .14s, border-color .14s, color .14s;
  }
  .controls button:hover { border-color: var(--accent); }
  .controls button.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .controls .run { margin-left: auto; min-width: 74px; }

  .motion-note { display: none; margin: 14px 0 0; font-size: 12.5px; color: var(--muted); }

  .group { margin-top: 34px; }
  .group h2 {
    display: flex; align-items: baseline; gap: 10px;
    font-size: 12px; font-weight: 650; text-transform: uppercase; letter-spacing: .09em;
    margin: 0 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line);
  }
  .group h2 span { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--muted); font-size: 12.5px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(158px, 1fr)); gap: 12px; }
  .spec { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .stage { height: 92px; display: grid; place-items: center; padding: 0 16px; }
  .spec figcaption { border-top: 1px solid var(--line); padding: 9px 12px 11px; }
  .spec figcaption b { display: block; font-size: 13px; font-weight: 600; }
  .spec figcaption span { display: block; margin-top: 2px; font-size: 12px; line-height: 1.4; color: var(--muted); }

  /* determinate ---------------------------------------------------------- */
  .bar { width: 100%; height: 6px; background: var(--bone); border-radius: 99px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: calc(var(--p) * 100%); background: var(--accent); border-radius: 99px; }

  .ring { width: 62px; height: 62px; transform: rotate(-90deg); }
  .ring circle { fill: none; stroke-width: 6; }
  .ring-track { stroke: var(--bone); }
  .ring-fill {
    stroke: var(--accent); stroke-linecap: round;
    stroke-dasharray: 163.363;
    stroke-dashoffset: calc(163.363px * (1 - var(--p)));
  }

  .seg { display: flex; gap: 3px; width: 100%; }
  .seg i { flex: 1; height: 14px; background: var(--bone); border-radius: 2px; }
  .seg i.on { background: var(--accent); }
  .seg i.hide { display: none; }

  .num { font-variant-numeric: tabular-nums; font-size: 30px; font-weight: 600; letter-spacing: -0.03em; }

  /* indeterminate -------------------------------------------------------- */
  .spinner {
    width: 40px; height: 40px; border-radius: 50%;
    border: 4px solid var(--bone); border-top-color: var(--accent);
    animation: spin .9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .ibar { position: relative; width: 100%; height: 6px; background: var(--bone); border-radius: 99px; overflow: hidden; }
  .ibar i { position: absolute; top: 0; bottom: 0; background: var(--accent); border-radius: 99px; animation: slide 1.9s cubic-bezier(.65,.815,.735,.395) infinite; }
  @keyframes slide {
    0%   { left: -34%; right: 100%; }
    60%  { left: 100%; right: -90%; }
    100% { left: 100%; right: -90%; }
  }

  .dots { display: flex; gap: 8px; }
  .dots span { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); animation: blink 1.3s ease-in-out infinite; }
  .dots span:nth-child(2) { animation-delay: .18s; }
  .dots span:nth-child(3) { animation-delay: .36s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .22; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }

  .skel { display: grid; gap: 8px; width: 100%; }
  .skel span {
    height: 10px; border-radius: 3px;
    background: linear-gradient(90deg, var(--bone) 0%, #f2f0ea 50%, var(--bone) 100%);
    background-size: 220% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
  }
  .skel .w70 { width: 70%; } .skel .w100 { width: 100%; } .skel .w45 { width: 45%; }
  @keyframes shimmer { 0% { background-position: 120% 0; } 100% { background-position: -120% 0; } }

  .foot { margin-top: 30px; font-size: 12.5px; color: var(--muted); }

  /* paused --------------------------------------------------------------- */
  .sheet.paused .spinner,
  .sheet.paused .ibar i,
  .sheet.paused .dots span,
  .sheet.paused .skel span { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) {
    .spinner, .ibar i, .dots span, .skel span { animation: none; }
    .ibar i { left: 0; right: 62%; }
    .dots span { opacity: .5; }
    .motion-note { display: block; }
  }
</style>

<script>
  const sheet = document.querySelector<HTMLElement>('.sheet')!;
  const barsWithAria = [...sheet.querySelectorAll<HTMLElement>('[role="progressbar"][aria-valuemax]')];
  const segHost = sheet.querySelector<HTMLElement>('.seg')!;
  const numEl = sheet.querySelector<HTMLElement>('.num')!;
  const toggle = sheet.querySelector<HTMLButtonElement>('#toggle')!;

  const HOLD_MS = 700;   // pause at 100% before looping, so the finish reads
  let duration = 3000;
  let steps = 0;          // 0 means smooth
  let running = true;
  let startedAt = performance.now();

  const segItems = [...segHost.querySelectorAll<HTMLElement>('i')];
  let segCount = 8;

  // Show only as many segments as the step setting calls for.
  function drawSegments() {
    segCount = steps || 8;
    segItems.forEach((seg, i) => seg.classList.toggle('hide', i >= segCount));
  }

  function quantize(p: number) {
    return steps ? Math.floor(p * steps) / steps : p;
  }

  function paint(p: number) {
    sheet.style.setProperty('--p', String(p));
    const pct = Math.round(p * 100);
    numEl.textContent = `${pct}%`;
    for (const el of barsWithAria) el.setAttribute('aria-valuenow', String(pct));
    const lit = Math.round(p * segCount);
    segItems.forEach((seg, i) => seg.classList.toggle('on', i < lit));
  }

  function frame(now: number) {
    if (running) {
      // run 0 -> 1, hold full for a fixed beat so the finish is legible, then loop
      const elapsed = now - startedAt;
      if (elapsed >= duration + HOLD_MS) startedAt = now;
      paint(quantize(Math.min(1, Math.max(0, elapsed / duration))));
    }
    requestAnimationFrame(frame);
  }

  function restart() {
    startedAt = performance.now();
    paint(0);
  }

  for (const btn of sheet.querySelectorAll<HTMLButtonElement>('[data-duration]')) {
    btn.addEventListener('click', () => {
      duration = Number(btn.dataset.duration);
      for (const sib of sheet.querySelectorAll('[data-duration]')) sib.classList.toggle('on', sib === btn);
      restart();
    });
  }

  for (const btn of sheet.querySelectorAll<HTMLButtonElement>('[data-steps]')) {
    btn.addEventListener('click', () => {
      steps = Number(btn.dataset.steps);
      for (const sib of sheet.querySelectorAll('[data-steps]')) sib.classList.toggle('on', sib === btn);
      drawSegments();
      restart();
    });
  }

  toggle.addEventListener('click', () => {
    running = !running;
    sheet.classList.toggle('paused', !running);
    toggle.textContent = running ? 'Pause' : 'Run';
    toggle.setAttribute('aria-pressed', String(!running));
    if (running) startedAt = performance.now();
  });

  drawSegments();
  paint(0);
  requestAnimationFrame(frame);
</script>
